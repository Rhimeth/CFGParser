digraph "Circle::printInfo_CFG" {
  node [shape=rectangle, fontname="Courier"];
  edge [fontname="Courier"];

  B0 [label="EXIT"];
  B1 [label="std::cout << "Circle: r="\nstd::cout << "Circle: r=" << this->radius\nstd::cout << "Circle: r=" << this->radius << " (Area: "\nthis->area()\nstd::cout << "Circle: r=" << this->radius << " (Area: " << this->area()\nstd::cout << "Circle: r=" << this->radius << " (Area: " << this->area() << ")\n""];
  B2 [label="ENTRY"];
  B1 -> B0;
  B2 -> B1;
}
