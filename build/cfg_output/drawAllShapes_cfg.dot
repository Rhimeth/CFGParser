digraph "drawAllShapes_CFG" {
  node [shape=rectangle, fontname="Courier"];
  edge [fontname="Courier"];

  B0 [label="EXIT"];
  B1 [label="__begin1 != __end1"];
  B2 [label="++ __begin1"];
  B3 [label="shape\nshape->print()\nstd::cout << "-------------------"\nstd::cout << "-------------------" << std::endl"];
  B4 [label="* __begin1\nconst auto &shape;
\nshape\nshape"];
  B5 [label="auto &&__range1 = shapes;
\n__range1.end()\nauto __end1 = __range1.end();
\n__range1.begin()\nauto __begin1 = __range1.begin();
"];
  B6 [label="ENTRY"];
  B1 -> B4 [label="true"];
  B1 -> B0 [label="false"];
  B2 -> B1;
  B3 -> B2;
  B4 -> B3 [label="true"];
  B4 -> B2 [label="false"];
  B5 -> B1;
  B6 -> B5;
}
